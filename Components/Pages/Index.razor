@page "/Index"
@using ChessAdmin.Components.Models
@rendermode InteractiveServer

<PageTitle>Dashboard Overview</PageTitle>

<div class="admin-shell">
    <Sideber/>
    <div class="admin-main">
        <Navbar />
        <main class="dashboard-content">
            <div class="container-fluid px-3 px-lg-4 py-4">

                <!-- Header Section -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">Dashboard Overview</h4>
                        <p class="text-muted small mb-0">ภาพรวมระบบผู้ใช้งานและการประมวลผลของ AI</p>
                    </div>
                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="LoadDashboardDataAsync" disabled="@isLoading">
                        <i class="bi bi-arrow-clockwise me-1"></i> รีเฟรชข้อมูล
                    </button>
                </div>

                <!-- 1. Top Metrics Cards Section -->
                <section class="row g-3 mb-4">
                    <!-- Total Users -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="metric-card metric-primary">
                            <div class="metric-top">
                                <span class="metric-label">Total Users</span>
                                <span class="metric-icon"><i class="bi bi-people-fill"></i></span>
                            </div>
                            <div class="metric-value">@dashboardData.TotalUsers.ToString("N0")</div>
                            <div class="metric-meta text-success">
                                <i class="bi bi-arrow-up-short"></i> ผู้เล่นในระบบทั้งหมด
                            </div>
                        </div>
                    </div>

                    <!-- Total Games -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="metric-card metric-success">
                            <div class="metric-top">
                                <span class="metric-label">Total Games</span>
                                <span class="metric-icon"><i class="bi bi-controller"></i></span>
                            </div>
                            <div class="metric-value">@dashboardData.TotalGames.ToString("N0")</div>
                            <div class="metric-meta text-success">
                                <i class="bi bi-arrow-up-short"></i> เกมที่เล่นทั้งหมด
                            </div>
                        </div>
                    </div>

                    <!-- Avg AI Move Time -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="metric-card metric-warning">
                            <div class="metric-top">
                                <span class="metric-label">Avg AI Move Time</span>
                                <span class="metric-icon"><i class="bi bi-lightning-charge-fill"></i></span>
                            </div>
                            <div class="metric-value">@dashboardData.AvgMoveTimeMs ms</div>
                            <div class="metric-meta text-muted">
                                Pruning Efficiency @dashboardData.PruningEfficiency%
                            </div>
                        </div>
                    </div>

                    <!-- Active System Issues -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="metric-card metric-danger">
                            <div class="metric-top">
                                <span class="metric-label">Active Issues</span>
                                <span class="metric-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
                            </div>
                            <div class="metric-value">@dashboardData.SystemIssues</div>
                            <div class="metric-meta @(dashboardData.SystemIssues > 0 ? "text-danger" : "text-success")">
                                @(dashboardData.SystemIssues > 0 ? "ต้องการการตรวจสอบ" : "สถานะระบบปกติ")
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. AI Analytics Chart & Recent Activity Section -->
                <section class="row g-3 mb-4">
                    <!-- Chart Panel -->
                    <div class="col-12 col-xl-8">
                        <div class="panel h-100">
                            <div class="panel-header">
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-cpu-fill me-2 text-primary"></i>AI Evaluated Nodes Comparison
                                </h6>
                                <NavLink class="btn btn-light btn-sm" href="ai-performance">ดูรายละเอียด</NavLink>
                            </div>
                            <div class="panel-body pt-2">
                                @if (aiPerformanceData?.BenchmarkHistory != null && aiPerformanceData.BenchmarkHistory.Any())
                                {
                                    <ApexChart TItem="AiBenchmarkDepthDto" Options="NodeChartOptions" Height="260">
                                        <ApexPointSeries TItem="AiBenchmarkDepthDto"
                                                         Items="aiPerformanceData.BenchmarkHistory"
                                                         Name="Minimax Nodes"
                                                         SeriesType="SeriesType.Bar"
                                                         XValue="@(e => $"Depth {e.Depth}")"
                                                         YValue="@(e => e.MinimaxNodes)" />
                                        <ApexPointSeries TItem="AiBenchmarkDepthDto"
                                                         Items="aiPerformanceData.BenchmarkHistory"
                                                         Name="Alpha-Beta Nodes"
                                                         SeriesType="SeriesType.Bar"
                                                         XValue="@(e => $"Depth {e.Depth}")"
                                                         YValue="@(e => e.AlphaBetaNodes)" />
                                    </ApexChart>
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted">
                                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                        กำลังดึงข้อมูล Analytics...
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Activity Panel -->
                    <div class="col-12 col-xl-4">
                        <div class="panel h-100">
                            <div class="panel-header">
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-activity me-2 text-success"></i>Recent AI Logs
                                </h6>
                            </div>
                            <div class="activity-list p-3">
                                <div class="activity-item">
                                    <span class="activity-dot bg-primary"></span>
                                    <div>
                                        <p class="mb-0 fw-semibold small">Alpha-Beta Pruning Active</p>
                                        <span class="text-muted extra-small">ลด Node การค้นหาได้อย่างมีประสิทธิภาพ</span>
                                    </div>
                                </div>
                                <div class="activity-item mt-3">
                                    <span class="activity-dot bg-success"></span>
                                    <div>
                                        <p class="mb-0 fw-semibold small">Optimal Search Depth</p>
                                        <span class="text-muted extra-small">ระบบประมวลผลตอบสนองรวดเร็ว</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 3. Recent Active Players Table Section -->
                <section class="panel">
                    <div class="panel-header">
                        <h6 class="fw-bold mb-0">
                            <i class="bi bi-people me-2 text-info"></i>ผู้ใช้งานล่าสุด
                        </h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Player</th>
                                    <th>Role</th>
                                    <th>Games Played</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (dashboardData?.RecentUsers != null && dashboardData.RecentUsers.Any())
                                {
                                    @foreach (var user in dashboardData.RecentUsers)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:32px; height:32px; font-size:13px;">
                                                        @(string.IsNullOrEmpty(user.Username) ? 'U' : char.ToUpper(user.Username[0]))
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold small">@user.Username</div>
                                                        <div class="text-muted extra-small">@user.Email</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@user.Role</span></td>
                                            <td class="small">@user.GamesPlayed</td>
                                            <td>
                                                @if (user.Status == "playing")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Playing</span>
                                                }
                                                else if (user.Status == "online")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Online</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Offline</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            ไม่พบข้อมูลผู้ใช้งานล่าสุด
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>
        </main>
    </div>
</div>