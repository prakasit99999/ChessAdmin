
@page "/users"
@rendermode InteractiveServer
@using ChessAdmin.Components.Pages.Base
<div class="admin-shell">
 <Sideber></Sideber>
 <div class="admin-main">
    <Navbar></Navbar>
     <main class="dashboard-content">
        <div class="container-fluid px-3 px-lg-4 py-4">

            <section class="row g-3 mt-1" aria-label="User summary">
                <div class="col-12 col-sm-6 col-xl-3">
                    <article class="metric-card metric-primary">
                        <div class="metric-top">
                            <span class="metric-label">Total Users</span>
                            <span class="metric-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                        </div>
                            <div class="metric-value">@totalCount</div>
                    </article>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <article class="metric-card metric-success">
                        <div class="metric-top">
                            <span class="metric-label">online</span>
                            <span class="metric-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
                        </div>
                        <div class="metric-value">@Online</div>
                    </article>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <article class="metric-card metric-warning">
                        <div class="metric-top">
                            <span class="metric-label">offline</span>
                            <span class="metric-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
                        </div>
                        <div class="metric-value">@Offline</div>
                    </article>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <article class="metric-card metric-danger">
                        <div class="metric-top">
                            <span class="metric-label">Pending</span>
                            <span class="metric-icon"><i class="bi bi-slash-circle" aria-hidden="true"></i></span>
                        </div>
                        <div class="metric-value">@Pending</div>
                    </article>
                </div>
            </section>
            <section class="panel mt-3">
                    <div class="panel-header">
                        <h2 class="h5 mb-1 section-title"><i class="bi bi-bar-chart" aria-hidden="true"></i><span>User Activity</span></h2>
                        <p class="text-muted mb-0">Monitor user activity and engagement over time.</p>
                    </div>
                    <div class="panel-body">
                        <div class="chart-container">
                         <ChartUser Users="users"></ChartUser>
                        </div>
                    </div>
            </section>

            <section class="panel mt-3">
                <div class="panel-header">
                    <div>
                        <h2 class="h5 mb-1 section-title"><i class="bi bi-table" aria-hidden="true"></i><span>User List</span></h2>
                        <p class="text-muted mb-0">Search, review, and manage team member accounts.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <input class="form-control form-control-sm table-search"
                               type="search"
                               placeholder="Search users"
                               aria-label="Search users"
                               @bind="search"
                               @bind:event="oninput"
                               @bind:after="SearchChanged" />
                            <button type="button"
                                    class="btn btn-primary btn-sm"
                                    @onclick="OpenAddUserModal">
                                <i class="bi bi-person-plus" aria-hidden="true"></i>
                                Add User
                            </button>
                        <a class="btn btn-light btn-sm" href="#"><i class="bi bi-download" aria-hidden="true"></i> Export</a>
                    </div>
                </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0" id="usersTable" data-searchable-table>
                            <thead>
                                <tr>
                                    <th scope="col">User</th>
                                    <th scope="col">Rating</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Action</th>
                                    <th scope="col">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLoading)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4">กำลังโหลดข้อมูล...</td>
                                    </tr>
                                }
                                else if (!string.IsNullOrWhiteSpace(errorMessage))
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-danger py-4">@errorMessage</td>
                                    </tr>
                                }
                                else if (users.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4">ไม่พบข้อมูลผู้ใช้</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var user in users)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div>
                                                        <p class="fw-semibold mb-0">@user.Username</p>
                                                        <p class="text-muted small mb-0">@user.Email</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@user.Rating</td>
                                            <td>
                                                <span class="badge @(user.Status.Equals("online", StringComparison.OrdinalIgnoreCase) ? "text-bg-success" : "text-bg-secondary")">
                                                    @user.Status
                                                </span>
                                            </td>
                                            <td><a class="btn btn-warning btn-sm" href="@($"/profile/edit/{user.UserId}")">View</a></td>
                                            <td><a class="btn btn-danger btn-sm" href="user-delete.html">Delete</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mt-3">
                    <p class="text-muted small mb-0">
                        Showing @ShowingFrom to @ShowingTo of @totalCount users
                    </p>
                    <nav aria-label="Users pagination">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                                <button class="page-link" type="button" @onclick="PreviousPage" disabled="@(pageNumber <= 1)">Previous</button>
                            </li>
                            @for (var page = 1; page <= TotalPages; page++)
                            {
                                var currentPage = page;
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <button class="page-link" type="button" @onclick="() => LoadUsersAsync(currentPage)">@currentPage</button>
                                </li>
                            }
                            <li class="page-item @(pageNumber >= TotalPages ? "disabled" : "")">
                                <button class="page-link" type="button" @onclick="NextPage" disabled="@(pageNumber >= TotalPages)">Next</button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </section>
        </div>
    </main>
  </div>
</div>
<AddUserModal IsVisible="@showAddUserModal"
              IsVisibleChanged="@OnAddUserModalChanged"
              OnUserAdded="@HandleUserAdded" />


