@page "/game/details/{GameId:int}"
@using ChessAdmin.Components.Models
@rendermode InteractiveServer

<div class="admin-shell">
    <Sideber></Sideber>
    <div class="admin-main">
        <Navbar></Navbar>
        <main class="dashboard-content">
            <div class="container-fluid px-3 px-lg-4 py-4">

                <!-- 1. State: Loading -->
                 @if (isLoading)
                { 
                     <div class="d-flex justify-content-center align-items-center py-5">
                        <div class="spinner-border text-primary me-2" role="status"></div>
                        <span class="text-muted fw-semibold">กำลังโหลดข้อมูลการแข่งขัน #@GameId...</span>
                    </div> 
                 } 
                <!-- 2. State: Error -->
                @if (!string.IsNullOrEmpty(errorMessage))
                { 
                 <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-1">เกิดข้อผิดพลาด</h5>
                        <p class="mb-0">@errorMessage</p>
                    </div>
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="history.back()">
                    <i class="bi bi-arrow-left me-1"></i> ย้อนกลับ
                </button> 
                 } 
                <!-- 3. State: Main Content -->
                @if (gameData != null)
                {
                <!-- Header Bar -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h1 class="h3 mb-0">Game Details #@(gameData?.GameId ?? GameId)d</h1>
                            <span class="badge @(gameData.GameStatus?.ToLower() == "finished" ? "bg-success" : "bg-primary")">
                                @(gameData.GameStatus?.ToUpper() ?? "UNKNOWN")
                            </span>
                            <span class="badge bg-warning text-dark">
                                @(gameData.MatchMode?.ToUpper() ?? "NORMAL")
                            </span>
                            <span class="badge bg-secondary">
                                @(gameData.GameType ?? "Single")
                            </span>
                        </div>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm" onclick="history.back()">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                </div>

                <!-- VS Player Banner -->
                <div class="panel p-3 mb-4">
                    <div class="row align-items-center text-center">
                        <!-- White Player -->
                        <div class="col-12 col-md-4 mb-3 mb-md-0">
                            <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-3">
                                <div class="rounded-circle bg-light border p-3">
                                    <i class="bi bi-person-fill fs-3 text-dark"></i>
                                </div>
                                <div class="text-start">
                                    <span class="badge text-bg-light border mb-1">White</span>
                                    <h5 class="mb-0 fw-bold">@(gameData.WhitePlayer?.Username ?? "Unknown")</h5>
                                    <small class="text-muted">
                                        @(gameData.WhitePlayer?.PlayerType ?? "Human") | Rating: @(gameData.WhitePlayer?.Rating ?? 1200)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Match Result -->
                        <div class="col-12 col-md-4 mb-3 mb-md-0 border-start border-end">
                            <span class="badge text-bg-danger mb-1">
                                @(gameData.Result ?? "In Progress")
                            </span>
                            <h4 class="fw-bold mb-0">
                                 @(gameData.Result == "white_wins" ? "1 - 0" : gameData.Result == "black_wins" ? "0 - 1" : "1/2 - 1/2") 
                            </h4>
                            <small class="text-muted">
                                Reason: @(gameData.ResultReason ?? "-") (@(gameData.Moves?.Count ?? 0) Moves)
                            </small>
                        </div>

                        <!-- Black Player -->
                        <div class="col-12 col-md-4">
                            <div class="d-flex align-items-center justify-content-center justify-content-md-end gap-3">
                                <div class="text-end">
                                    <span class="badge text-bg-dark mb-1">Black</span>
                                    <h5 class="mb-0 fw-bold">@(gameData.BlackPlayer?.Username ?? "Unknown")</h5>
                                    <small class="text-muted">
                                        @(gameData.BlackPlayer?.PlayerType ?? "AI") | Rating: @(gameData.BlackPlayer?.Rating ?? 1200)
                                    </small>
                                </div>
                                <div class="rounded-circle bg-dark text-white p-3">
                                    <i class="bi bi-cpu-fill fs-3"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Layout Grid -->
                <div class="row g-4">

                    <!-- Left Column: Board & Replay Controls -->
                    <div class="col-12 col-lg-5">
                        <div class="panel p-3 text-center">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="h6 mb-0 fw-bold">Board Position</h5>
                                <span class="badge bg-secondary">
                                    Move @currentMoveIndex / @(fenHistory != null && fenHistory.Count > 0 ? fenHistory.Count - 1 : 0)
                                </span>
                            </div>

                            <!-- Board Component -->
                            <div class="d-flex justify-content-center mb-3">
                                <ChessBoard Position="@currentFen" />
                            </div>

                            <!-- Playback Controls -->
                            <div class="btn-group w-100 mb-3" role="group" aria-label="Replay controls">
                                <button class="btn btn-outline-secondary" @onclick="FirstMove" title="First Move">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="PrevMove" title="Previous Move">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="btn btn-primary px-4" @onclick="TogglePlay">
                                    <i class="bi @(isPlaying ? "bi-pause-fill" : "bi-play-fill") me-1"></i>
                                    @(isPlaying ? "Pause" : "Play")
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="NextMove" title="Next Move">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="LastMove" title="Last Move">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                            </div>

                            <!-- FEN Input -->
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light fw-semibold">FEN</span>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@currentFen" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: AI Performance & Move Log -->
                    <div class="col-12 col-lg-7">

                        <!-- AI Performance Stats -->
                        @if (gameData.AiPerformance != null)
                        {
                            <div class="panel p-3 mb-4 bg-light-subtle border">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <i class="bi bi-cpu text-primary fs-5"></i>
                                    <h5 class="h6 mb-0 fw-bold">AI Performance Metrics</h5>
                                </div>
                                <div class="row g-3 text-center">
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 border rounded bg-white">
                                            <small class="text-muted d-block mb-1">Algorithm</small>
                                            <span class="fw-bold text-dark">@(gameData.AiPerformance.AlgorithmType ?? "N/A")</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 border rounded bg-white">
                                            <small class="text-muted d-block mb-1">Avg Depth</small>
                                            <span class="fw-bold text-dark">@(gameData.AiPerformance.AiDepthSearched?.ToString() ?? "-")</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 border rounded bg-white">
                                            <small class="text-muted d-block mb-1">Avg Nodes</small>
                                            <span class="fw-bold text-dark">@(gameData.AiPerformance.AiNodesEvaluated?.ToString("N0") ?? "-")</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-sm-3">
                                        <div class="p-2 border rounded bg-white">
                                            <small class="text-muted d-block mb-1">Avg Speed</small>
                                            <span class="fw-bold text-dark">@(gameData.AiPerformance.AiMoveTimeMs.HasValue ? $"{gameData.AiPerformance.AiMoveTimeMs} ms" : "-")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Move Log Table -->
                        <div class="panel p-0 overflow-hidden">
                            <div class="panel-header p-3 border-bottom d-flex justify-content-between align-items-center">
                                <h5 class="h6 mb-0 fw-bold"><i class="bi bi-list-ol me-2"></i>Move History Log</h5>
                                <span class="badge text-bg-light border">@(gameData.Moves?.Count ?? 0) Moves Total</span>
                            </div>
                            <div class="table-responsive" style="max-height: 380px;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 10%;">#</th>
                                            <th style="width: 15%;">Team</th>
                                            <th style="width: 20%;">Piece</th>
                                            <th style="width: 25%;">Move</th>
                                            <th style="width: 15%;">Event</th>
                                            <th style="width: 15%;">Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (gameData.Moves != null && gameData.Moves.Any())
                                        {
                                            @foreach (var move in gameData.Moves.OrderBy(m => m.MoveNumber))
                                            {
                                                <tr class="@(currentMoveIndex == move.MoveNumber ? "table-active fw-bold" : "")"
                                                    @onclick="() => GoToMove(move.MoveNumber)"
                                                    style="cursor: pointer;">

                                                    <td><strong>@move.MoveNumber</strong></td>
                                                    <td>
                                                        <span class="badge @(move.Team?.ToLower() == "white" ? "text-bg-light border" : "text-bg-dark")">
                                                            @move.Team
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @move.PieceType
                                                        @if (!string.IsNullOrEmpty(move.San))
                                                        {
                                                            <span class="text-primary ms-1">(@move.San)</span>
                                                        }
                                                    </td>
                                                    <td><code>@(string.IsNullOrEmpty(move.MoveText) ? $"{move.FromPosition} -> {move.ToPosition}" : move.MoveText)</code></td>
                                                    <td>
                                                        @if (move.IsCheck)
                                                        {
                                                            <span class="badge bg-warning text-dark">Check</span>
                                                        }
                                                        else if (move.IsCapture)
                                                        {
                                                            <span class="badge bg-danger">Capture @(!string.IsNullOrEmpty(move.CapturedPieceType) ? $"({move.CapturedPieceType})" : "")</span>
                                                        }
                                                        else if (move.IsCastling)
                                                        {
                                                            <span class="badge bg-info text-dark">Castle</span>
                                                        }
                                                        else if (move.IsEnPassant)
                                                        {
                                                            <span class="badge bg-secondary">En Passant</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>@(move.MoveTimeMs.HasValue ? $"{move.MoveTimeMs} ms" : "-")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-3">ยังไม่มีประวัติการเดินในเกมนี้</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                 </div>
                }else
                {
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    <i class="bi bi-exclamation-circle-fill fs-4 me-3"></i>
                    <div>
                        ไม่พบข้อมูลการแข่งขันสำหรับ Game ID: @GameId
                    </div>
                </div>
                <button class="btn btn-outline-secondary btn-sm" onclick="history.back()">
                    <i class="bi bi-arrow-left me-1"></i> ย้อนกลับ
                </button>
                }

            </div>
        </main>
    </div>
</div>
